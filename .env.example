# Copy to .env and fill in real values. NEVER commit .env.

# Groq API key — required for any agent run.
# Get one at https://console.groq.com/keys (free, no credit card).
GROQ_API_KEY=gsk_REPLACE_ME

# Model routing (defaults in src/issue_to_pr/settings.py; override only if needed)
PLANNER_MODEL=openai/gpt-oss-120b
EXECUTOR_MODEL=openai/gpt-oss-20b
VERIFIER_MODEL=openai/gpt-oss-120b

# Postgres (Week 3+) — pgsql-portable defaults
DATABASE_URL=postgresql://itp:itp@localhost:5432/itp

# Sandbox limits
SANDBOX_TIMEOUT_SECONDS=1200
SANDBOX_MEMORY_LIMIT=2g

# Langfuse (Week 3) — leave empty until then
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
