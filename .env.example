# Copy to .env and fill in real values. NEVER commit .env.

# Anthropic API key — required for any agent run.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Model routing (defaults declared in src/issue_to_pr/settings.py — override here only if needed)
PLANNER_MODEL=claude-sonnet-4-6
EXECUTOR_MODEL=claude-haiku-4-5-20251001
VERIFIER_MODEL=claude-sonnet-4-6

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://itp:itp@localhost:5432/itp

# Sandbox limits
SANDBOX_TIMEOUT_SECONDS=1200
SANDBOX_MEMORY_LIMIT=2g

# Langfuse (Week 3 — leave empty until then)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
